# ==============================================================================
# AI Loan Eligibility Checker - Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# Server Configuration
PORT=5000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 1. Anthropic Claude AI API Configuration
# Get your API key from: https://console.anthropic.com/
# If left empty, the application will use the built-in intelligent rule engine.
# ------------------------------------------------------------------------------
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. Google Sheets API Configuration (Optional)
# If left empty, applications will safely be stored in local backend/data/applications.json.
# Follow the README.md instructions for step-by-step setup in Google Cloud Console.
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternatively, specify the path to your downloaded Service Account JSON file:
# GOOGLE_CREDENTIALS_FILE=backend/credentials.json
